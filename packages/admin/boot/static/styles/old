.button {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius);
  gap: var(--space-y);
  user-select: none;
  cursor: pointer;
  transition:
    color var(--transition-fast),
    background-color var(--transition-fast),
    border-color var(--transition-fast);
}

.button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.button--primary {
  color: var(--background);
  background: var(--button);
  border-color: var(--button);
}

.button--primary:hover:not(:disabled) {
  background: var(--button-hover);
  border-color: var(--button-hover);
}

.button--secondary {
  color: var(--text);
  background: var(--button-muted);
  border-color: var(--color-border);
}

.button--secondary:hover:not(:disabled) {
  background: var(--button-muted-hover);
}

.button--ghost {
  color: var(--text);
  background: transparent;
  border-color: transparent;
}

.button--ghost:hover:not(:disabled) {
  background: var(--button-muted);
}

.button--danger {
  color: var(--background);
  background: var(--error);
  border-color: var(--error);
}

.button--danger:hover:not(:disabled) {
  background: var(--error);
  border-color: var(--error);
}

.button--link {
  color: var(--link);
  background: transparent;
  border-color: transparent;
  padding-left: 0;
  padding-right: 0;
}

.button--link:hover:not(:disabled) {
  color: var(--text-hover);
}

.button--xs {
  height: calc(var(--baseline) * 9);
  padding: calc(var(--spacing) * 2);
}

.button--sm {
  height: calc(var(--baseline) * 9);
  padding: 0 calc(var(--spacing) * 2.5);
  font-size: var(--text-xs);
}

.button--md {
  height: calc(var(--baseline) * 11);
  padding: 0 var(--space-y);
  font-size: var(--text-sm);
}

.button--lg {
  height: calc(var(--baseline) * 12);
  padding: 0 calc(var(--space-y) + var(--spacing));
  font-size: var(--text-base);
}

.button--xl {
  height: calc(var(--baseline) * 13);
  padding: 0 var(--space-x);
  font-size: var(--text-lg);
}


/*--------------------------*//*--------------------------*/

.auth-provider-button {
  display: flex;
  height: 2.0625rem;
  align-items: center;
  justify-content: center;
  color: var(--text-ghost);
  background: var(--button-solid);
  gap: calc(var(--layout-gap) * 2);
  padding: calc(var(--spacing) * 3);
  border: var(--border);
  position: relative;
  width: stretch;
}

.auth-provider-button:hover {
  color: var(--text-hover);
  background: var(--button-solid-hover);
}

.auth-provider-button__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity var(--duration-fast) var(--easing),
    transform var(--duration-fast) var(--easing);
  width: 1rem;
  height: 1rem;
}

.auth-provider-button__label {
  transition: opacity var(--duration-fast) var(--easing),
    transform var(--duration-fast) var(--easing);
}




.admin-main__sidebar button {
  height: var(--sidebar);
  width: calc(var(--sidebar) - 1px);
  min-height: var(--sidebar);
  max-height: var(--sidebar);
  background: transparent;
  position: relative;
  cursor: pointer;
  flex: 0 1 100%;
}

.admin-main__sidebar button::after {
  content: '';
  position: absolute;
  background: var(--button-ghost);
  transition: background var(--transition-fast);
  opacity: 0.5;
  z-index: 0;
  inset: 0;
}

.admin-main__sidebar button:hover::after {
  background: var(--button-ghost-hover);
}

.admin-main__sidebar-icon {
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: var(--sidebar-icon-stroke-width);
  width: var(--sidebar-icon-size);
  height: var(--sidebar-icon-size);
  pointer-events: none;
  position: relative;
  z-index: 1;
}



.studio-scheme__menu-content button {
  display: inline-flex;
  border-radius: calc(var(--radius) / 2);
}

.studio-scheme__menu-content button:hover {
  background: var(--button-ghost-hover);
}


.studio-scheme__trigger {
  border: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  text-align: left;
  cursor: pointer;
  gap: calc(var(--spacing) * 0.75);
}

.studio-scheme__trigger::after {
  content: '';
  position: absolute;
  width: var(--header);
  height: var(--header);
  background: transparent;
  transition: background var(--transition-fast);
  border-radius: calc(var(--radius) / 2);
  z-index: -1;
}

.studio-scheme__trigger:hover::after {
  background: var(--button-ghost-hover);
}

.studio-scheme__icon {
  fill: none;
  stroke: currentColor;
  stroke-linecap: round;
  stroke-linejoin: round;
  pointer-events: none;
  stroke-width: 1.75;
  width: 1rem;
  height: 1rem;
  flex: 0 0 auto;
}
