{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "paths": {
      "@/*": ["./src/*"],
      "@atria/ui/*": ["../ui/dist/*"]
    },
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": false,
    "declarationMap": false
  },
  "include": ["src/**/*"]
}
