{
  "name": "@atria/server",
  "version": "0.0.44",
  "description": "Server package",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "rm -rf dist && cp -R src dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@atria/db": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.js"
    },
    "./*": "./src/*"
  },
  "engines": {
    "node": ">=22"
  }
}
